DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=project_X
DB_USER=bun_sso_identity
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS_PER_MINUTE=120
TRUST_PROXY_HEADERS=false

IDENTITY_PORT=3001
SSO_ISSUER=https://auth.example.com
SSO_ACCESS_TOKEN_TTL_SECONDS=600
SSO_ID_TOKEN_TTL_SECONDS=600
SSO_AUTHORIZATION_CODE_TTL_SECONDS=90
SSO_DEVICE_CODE_TTL_SECONDS=600
SSO_REFRESH_TOKEN_TTL_SECONDS=2592000
SSO_BROWSER_SESSION_TTL_SECONDS=28800
SSO_AUTH_CHALLENGE_TTL_SECONDS=300
SSO_LOGIN_APPROVAL_TTL_SECONDS=600
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN_FILE=/vault/secrets/token
VAULT_TRANSIT_MOUNT=sso-jwt
VAULT_TRANSIT_ACCESS_KEY=access-token
VAULT_KEY_CACHE_SECONDS=30

BUSINESS_API_AUDIENCE=urn:bun-sso:business-api
WEBAPP_OAUTH_CLIENT_ID=x-webapp
WEBAPP_OAUTH_REDIRECT_URIS=http://localhost:5173/oauth/callback
FINANCE_OAUTH_CLIENT_ID=finance-web
FINANCE_OAUTH_REDIRECT_URIS=http://127.0.0.1:5173/oauth/callback
DOCUMENTS_OAUTH_CLIENT_ID=documents-web
DOCUMENTS_OAUTH_REDIRECT_URIS=http://127.0.0.1:5174/oauth/callback
MARKET_OAUTH_CLIENT_ID=market-client
MARKET_OAUTH_REDIRECT_URIS=http://127.0.0.1:5175/oauth/callback
